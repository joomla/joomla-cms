<?xml version="1.0" encoding="UTF-8"?>
<form addruleprefix="Joomla\Component\Workflow\Administrator\Rule">
	<config>
		<inlinehelp button="show"/>
	</config>
	<fieldset name="transition" addfieldprefix="Joomla\Component\Workflow\Administrator\Field">
		<field
			name="id"
			type="hidden"
			label="JGLOBAL_FIELD_ID_LABEL"
			default="0"
			class="readonly"
			readonly="true"
		/>
		<field
			name="title"
			type="text"
			label="COM_WORKFLOW_FIELD_NAME_LABEL"
			required="true"
		/>
		<field
			name="from_stage_id"
			type="sql"
			label="COM_WORKFLOW_FROM_STAGE"
			required="true"
			sql_select="id as value, title as from_stage_id"
			sql_from="#__workflow_stages"
			sql_order="ordering"
			translate="true"
			>
			<option value="-1">JALL</option>
		</field>
		<field
			name="to_stage_id"
			type="sql"
			label="COM_WORKFLOW_TO_STAGE"
			required="true"
			sql_select="id as value, title as to_stage_id"
			sql_from="#__workflow_stages"
			sql_order="ordering"
			translate="true"
		/>
		<field
			name="description"
			type="textarea"
			label="COM_WORKFLOW_TRANSITION_NOTE"
			rows="3"
			cols="60"
		/>
	</fieldset>

	<fieldset name="params" label="COM_WORKFLOW_PARAMS_LABEL">
		<field
			name="published"
			type="list"
			label="COM_WORKFLOW_PUBLISHED_LABEL"
			required="true"
			class="form-select-color-state"
			default="1"
			validate="options"
			>
			<option value="1">JENABLED</option>
			<option value="0">JDISABLED</option>
			<option value="-2">JTRASHED</option>
		</field>
	</fieldset>

	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL">
		<field
			name="asset_id"
			type="hidden"
			filter="unset"
		/>
		<field
			name="rules"
			type="rules"
			label="JCONFIG_PERMISSIONS_LABEL"
			validate="rules"
			filter="rules"
			section="transition"
		/>
	</fieldset>
	<fields name="automation">
		<fieldset name="automation" label="COM_WORKFLOW_AUTOMATION_FIELDSET_LABEL">


			<field
				name="automation_enabled"
				type="radio"
				label="COM_WORKFLOW_AUTOMATION_ENABLE_TRANSITION_LABEL"
				layout="joomla.form.field.radio.switcher"
				description="COM_WORKFLOW_AUTOMATION_ENABLE_TRANSITION_DESC"
				default="0"
				>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<field
				name="run_as_user_id"
				type="user"
				label="COM_WORKFLOW_AUTOMATION_RUN_AS_LABEL"
				description="COM_WORKFLOW_AUTOMATION_RUN_AS_DESC"
				validate="RunAsUser"
				showon="automation_enabled:1"
			/>

			<field
				name="automation_rules"
				type="subform"
				label="COM_WORKFLOW_AUTOMATION_RULES_LABEL"
				description="COM_WORKFLOW_AUTOMATION_RULES_DESC"
				layout="joomla.form.field.subform.default"
				formsource="administrator/components/com_workflow/forms/automation_rule.xml"
				showon="automation_enabled:1"
			/>


		</fieldset>
	</fields>
</form>
