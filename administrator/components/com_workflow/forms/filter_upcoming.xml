<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="list">
		<field
			name="workflow_id"
			type="sql"
			label="COM_WORKFLOW_UPCOMING_FILTER_WORKFLOW"
			key_field="id"
			value_field="title"
			sql_select="id, title"
			sql_from="#__workflows"
			sql_where="published = 1"
			sql_order="ordering"
			translate="true"
			class="js-select-submit-on-change"
			>
			<option value="">COM_WORKFLOW_UPCOMING_FILTER_WORKFLOW</option>
		</field>
		<field
			name="stage_id"
			type="sql"
			label="COM_WORKFLOW_UPCOMING_FILTER_STAGE"
			key_field="id"
			value_field="title"
			sql_select="s.id, s.title"
			sql_from="#__workflow_stages AS s"
			sql_join="#__workflows AS w ON w.id = s.workflow_id"
			sql_where="s.published = 1"
			sql_order="w.ordering, s.ordering"
			translate="true"
			class="js-select-submit-on-change"
			>
			<option value="">COM_WORKFLOW_UPCOMING_FILTER_STAGE</option>
		</field>
		<field
			name="limit"
			type="limitbox"
			label="JGLOBAL_LIST_LIMIT"
			default="20"
			class="js-select-submit-on-change"
		/>
	</fields>
</form>
