<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>plg_system_redirect</name>
	<author>Joomla! Project</author>
	<creationDate>2009-04</creationDate>
	<copyright>(C) 2009 Open Source Matters, Inc.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>admin@joomla.org</authorEmail>
	<authorUrl>www.joomla.org</authorUrl>
	<version>3.0.0</version>
	<description>PLG_SYSTEM_REDIRECT_XML_DESCRIPTION</description>
	<namespace path="src">Joomla\Plugin\System\Redirect</namespace>
	<files>
		<folder>form</folder>
		<folder plugin="redirect">services</folder>
		<folder>src</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/plg_system_redirect.ini</language>
		<language tag="en-GB">language/en-GB/plg_system_redirect.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="collect_urls"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					label="PLG_SYSTEM_REDIRECT_FIELD_COLLECT_URLS_LABEL"
					default="1"
					filter="integer"
					>
					<option value="0">JDISABLED</option>
					<option value="1">JENABLED</option>
				</field>
				<field
					name="includeUrl"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					label="PLG_SYSTEM_REDIRECT_FIELD_STORE_FULL_URL_LABEL"
					default="1"
					filter="integer"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="exclude_urls"
					type="subform"
					label="PLG_SYSTEM_REDIRECT_FIELD_EXCLUDE_URLS_LABEL"
					multiple="true"
					formsource="plugins/system/redirect/form/excludes.xml"
					layout="joomla.form.field.subform.repeatable-table"
				/>

				<field
					name="redirect_on_save_admin"
					type="radio"
					label="PLG_SYSTEM_REDIRECT_FIELD_REDIRECT_ON_SAVE_ADMIN_LABEL"
					description="PLG_SYSTEM_REDIRECT_FIELD_REDIRECT_ON_SAVE_ADMIN_DESC"
					class="btn-group btn-group-yesno"
					default="1"
					filter="integer"
					layout="joomla.form.field.radio.buttons"
					>
					<option value="0" class="btn btn-outline-danger">JNO</option>
					<option value="2" class="btn btn-outline-warning">PLG_SYSTEM_REDIRECT_FIELD_REDIRECT_ON_SAVE_ADMIN_MANUALLY</option>
					<option value="1" class="btn btn-outline-success">JYES</option>
				</field>

				<field
					name="redirect_on_save_site"
					type="radio"
					label="PLG_SYSTEM_REDIRECT_FIELD_REDIRECT_ON_SAVE_SITE_LABEL"
					description="PLG_SYSTEM_REDIRECT_FIELD_REDIRECT_ON_SAVE_SITE_DESC"
					class="btn-group btn-group-yesno"
					default="1"
					filter="integer"
					layout="joomla.form.field.radio.buttons"
					>
					<option value="0" class="btn btn-outline-danger">JNO</option>
					<option value="1" class="btn btn-outline-success">JYES</option>
				</field>

				<field
					name="ignored_components"
					type="RedirectComponents"
					label="PLG_SYSTEM_REDIRECT_IGNORED_COMPONENTS_LABEL"
					description="PLG_SYSTEM_REDIRECT_IGNORED_COMPONENTS_DESCRIPTION"
					multiple="multiple"
					layout="joomla.form.field.list-fancy-select"
					showon="redirect_on_save_admin:1[OR]redirect_on_save_admin:2[OR]redirect_on_save_site:1"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
