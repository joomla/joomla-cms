<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="healthcheck" method="upgrade">
	<name>PLG_HEALTHCHECK_USERMAINTENANCE</name>
	<author>Joomla! Project</author>
	<creationDate>2026-08-04</creationDate>
	<copyright>(C) 2026 Open Source Matters, Inc.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>admin@joomla.org</authorEmail>
	<authorUrl>www.joomla.org</authorUrl>
	<version>1.0.0</version>
	<description>PLG_HEALTHCHECK_USERMAINTENANCE_XML_DESCRIPTION</description>
	<namespace path="src">Joomla\Plugin\Healthcheck\UserMaintenance</namespace>
	<files>
		<folder plugin="usermaintenance">services</folder>
		<folder>src</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/plg_healthcheck_usermaintenance.ini</language>
		<language tag="en-GB">language/en-GB/plg_healthcheck_usermaintenance.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="context"
					type="text"
					label="PLG_HEALTHCHECK_USERMAINTENANCE_GROUP_LABEL"
					description="PLG_HEALTHCHECK_USERMAINTENANCE_GROUP_DESC"
					default="performance"
				/>
				<field
					name="inactiveUsers"
					type="radio"
					label="PLG_HEALTHCHECK_USERMAINTENANCE_INACTIVE_LISTTEXT"
					description="PLG_HEALTHCHECK_USERMAINTENANCE_INACTIVE_LISTNOTE"
					layout="joomla.form.field.radio.switcher"
					default="1"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="inactiveTimespan"
					type="list"
					description="PLG_HEALTHCHECK_USERMAINTENANCE_INACTIVETIMESPAN_DESC"
					label="PLG_HEALTHCHECK_USERMAINTENANCE_INACTIVETIMESPAN_LABEL"
					default="180"
				>
					<option value="90">PLG_HEALTHCHECK_USERMAINTENANCE_INACTIVETIMESPAN_M3</option>
					<option value="180">PLG_HEALTHCHECK_USERMAINTENANCE_INACTIVETIMESPAN_M6</option>
					<option value="360">PLG_HEALTHCHECK_USERMAINTENANCE_INACTIVETIMESPAN_Y1</option>
				</field>
				<field
					name="neverloggedinUsers"
					type="radio"
					label="PLG_HEALTHCHECK_USERMAINTENANCE_NEVERLOGGEDIN_LISTTEXT"
					description="PLG_HEALTHCHECK_USERMAINTENANCE_NEVERLOGGEDIN_LISTNOTE"
					layout="joomla.form.field.radio.switcher"
					default="1"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="unactivatedUsers"
					type="radio"
					label="PLG_HEALTHCHECK_USERMAINTENANCE_UNACTIVATED_LISTTEXT"
					description="PLG_HEALTHCHECK_USERMAINTENANCE_UNACTIVATED_LISTNOTE"
					layout="joomla.form.field.radio.switcher"
					default="1"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="orphanUsers"
					type="radio"
					label="PLG_HEALTHCHECK_USERMAINTENANCE_ORPHAN_LISTTEXT"
					description="PLG_HEALTHCHECK_USERMAINTENANCE_ORPHAN_LISTNOTE"
					layout="joomla.form.field.radio.switcher"
					default="1"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="nonMFAUsers"
					type="radio"
					label="PLG_HEALTHCHECK_USERMAINTENANCE_NONMFA_LISTTEXT"
					description="PLG_HEALTHCHECK_USERMAINTENANCE_NONMFA_LISTNOTE"
					layout="joomla.form.field.radio.switcher"
					default="1"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="privilegedUsers"
					type="radio"
					label="PLG_HEALTHCHECK_USERMAINTENANCE_PRIVILEGED_LISTTEXT"
					description="PLG_HEALTHCHECK_USERMAINTENANCE_PRIVILEGED_LISTNOTE"
					layout="joomla.form.field.radio.switcher"
					default="1"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>

				<field
					name="logging"
					type="list"
					description="PLG_HEALTHCHECK_USERMAINTENANCE_LOGGING_DESC"
					label="PLG_HEALTHCHECK_USERMAINTENANCE_LOGGING_LABEL"
					default="0"
				>
					<option value="0">PLG_HEALTHCHECK_USERMAINTENANCE_LOGGING_VALUE_NOLOG</option>
					<option value="1">PLG_HEALTHCHECK_USERMAINTENANCE_LOGGING_VALUE_PHPLOG</option>
					<option value="2">PLG_HEALTHCHECK_USERMAINTENANCE_LOGGING_VALUE_JOOMLALOG</option>
					<option value="3">PLG_HEALTHCHECK_USERMAINTENANCE_LOGGING_VALUE_MESSAGE</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
