<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="workflow" method="upgrade">
	<name>plg_workflow_remotecheck</name>
	<author>Joomla! Project</author>
	<creationDate>2026-08</creationDate>
	<copyright>(C) 2026 Open Source Matters, Inc.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>admin@joomla.org</authorEmail>
	<authorUrl>www.joomla.org</authorUrl>
	<version>1.0.0</version>
	<description>PLG_WORKFLOW_REMOTECHECK_XML_DESCRIPTION</description>
	<namespace path="src">Joomla\Plugin\Workflow\RemoteCheck</namespace>
	<files>
		<folder plugin="remotecheck">services</folder>
		<folder>src</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/plg_workflow_remotecheck.ini</language>
		<language tag="en-GB">language/en-GB/plg_workflow_remotecheck.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="checklabel"
					type="text"
					label="PLG_WORKFLOW_REMOTECHECK_CHECKLABEL_LABEL"
					description="PLG_WORKFLOW_REMOTECHECK_CHECKLABEL_DESC"
					filter="string"
					required="true"
				/>
				<field
					name="endpoint"
					type="url"
					label="PLG_WORKFLOW_REMOTECHECK_ENDPOINT_LABEL"
					description="PLG_WORKFLOW_REMOTECHECK_ENDPOINT_DESC"
					filter="url"
					validate="url"
					relative="false"
				/>
				<field
					name="authheader"
					type="text"
					label="PLG_WORKFLOW_REMOTECHECK_AUTHHEADER_LABEL"
					description="PLG_WORKFLOW_REMOTECHECK_AUTHHEADER_DESC"
					default="Authorization"
					filter="string"
				/>
				<field
					name="authvalue"
					type="password"
					label="PLG_WORKFLOW_REMOTECHECK_AUTHVALUE_LABEL"
					description="PLG_WORKFLOW_REMOTECHECK_AUTHVALUE_DESC"
					filter="raw"
					autocomplete="off"
				/>
				<field
					name="timeout"
					type="number"
					label="PLG_WORKFLOW_REMOTECHECK_TIMEOUT_LABEL"
					description="PLG_WORKFLOW_REMOTECHECK_TIMEOUT_DESC"
					default="5"
					min="1"
					max="30"
					filter="integer"
				/>
				<field
					name="cachelifetime"
					type="number"
					label="PLG_WORKFLOW_REMOTECHECK_CACHELIFETIME_LABEL"
					description="PLG_WORKFLOW_REMOTECHECK_CACHELIFETIME_DESC"
					default="15"
					min="1"
					max="1440"
					filter="integer"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
