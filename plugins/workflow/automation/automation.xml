<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="workflow" method="upgrade">
	<name>plg_workflow_automation</name>
	<author>Joomla! Project</author>
	<creationDate>2026-06</creationDate>
	<copyright>(C) 2026 Open Source Matters, Inc.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>admin@joomla.org</authorEmail>
	<authorUrl>www.joomla.org</authorUrl>
	<version>1.0.0</version>
	<description>PLG_WORKFLOW_AUTOMATION_XML_DESCRIPTION</description>
	<namespace path="src">Joomla\Plugin\Workflow\Automation</namespace>
	<files>
		<folder plugin="automation">services</folder>
		<folder>forms</folder>
		<folder>src</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/plg_workflow_automation.ini</language>
		<language tag="en-GB">language/en-GB/plg_workflow_automation.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="expert_mode"
					type="radio"
					label="PLG_WORKFLOW_AUTOMATION_FIELD_EXPERT_MODE_LABEL"
					description="PLG_WORKFLOW_AUTOMATION_FIELD_EXPERT_MODE_DESC"
					layout="joomla.form.field.radio.switcher"
					default="0"
					filter="integer"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
