<?xml version="1.0" encoding="UTF-8"?>
<form>
	<field
		name="default_value"
		type="modal_article"
		label="PLG_FIELDS_ARTICLE_DEFAULT_VALUE_LABEL"
		addfieldprefix="Joomla\Component\Content\Administrator\Field"
		validate="ArticleId"
		select="true"
		new="true"
		edit="true"
		clear="true"
	/>
	<fields name="fieldparams">
		<fieldset name="fieldparams">
			<field
				name="allow_new"
				type="radio"
				label="PLG_FIELDS_ARTICLE_PARAMS_ALLOW_NEW_LABEL"
				description="PLG_FIELDS_ARTICLE_PARAMS_ALLOW_NEW_DESC"
				layout="joomla.form.field.radio.switcher"
				default="1"
				filter="integer"
				>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>

			<field
				name="allow_edit"
				type="radio"
				label="PLG_FIELDS_ARTICLE_PARAMS_ALLOW_EDIT_LABEL"
				description="PLG_FIELDS_ARTICLE_PARAMS_ALLOW_EDIT_DESC"
				layout="joomla.form.field.radio.switcher"
				default="1"
				filter="integer"
				>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
		</fieldset>
	</fields>
	<fields name="params" label="COM_FIELDS_FIELD_BASIC_LABEL">
		<fieldset name="basic">
			<field
				name="show_on"
				type="hidden"
				filter="unset"
			/>
		</fieldset>
		<fieldset name="renderoptions">
			<field
				name="show_archived"
				type="radio"
				label="PLG_FIELDS_ARTICLE_PARAMS_SHOW_ARCHIVED_LABEL"
				description="PLG_FIELDS_ARTICLE_PARAMS_SHOW_ARCHIVED_DESC"
				layout="joomla.form.field.radio.switcher"
				default="1"
				filter="integer"
				>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>

			<field
				name="show_noauth"
				type="list"
				label="JGLOBAL_SHOW_UNAUTH_LINKS_LABEL"
				description="JGLOBAL_SHOW_UNAUTH_LINKS_DESC"
				useglobal="true"
				validate="options"
				>
				<option value="use_article">PLG_FIELDS_ARTICLE_PARAMS_SHOW_NOAUTH_USE_ARTICLE</option>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
		</fieldset>
	</fields>
</form>
