{
  "files": {
    "includes": [
      "build/**/*.{js,mjs,es6,vue,css}",
      "tests/**/*.{js,mjs,es6,vue}",
      "administrator/components/com_media/resources/scripts/**/*.{js,mjs,es6,vue}",
      "!**/*.es5.js",
      "!build/warning_page/*.js"
    ]
  },
  "linter": {
    "includes": [
      "build/**/*.{js,mjs,es6,vue,css}",
      "tests/**/*.{js,mjs,es6,vue}",
      "administrator/components/com_media/resources/scripts/**/*.{js,mjs,es6,vue}",
      "!**/*.es5.js",
      "!build/warning_page/*.js"
    ],
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noRedundantUseStrict": "off",
        "noDocumentCookie": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      "a11y": {
        "useGenericFontNames": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "recommended": true
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "globals": ["Joomla", "MediaManager", "bootstrap"],
    "formatter": {
      "quoteStyle": "single",
      "bracketSameLine": true,
      "lineWidth": 150
    }
  },
  "json": {
    "linter": {
      "enabled": false
    },
    "formatter": {
      "enabled": false
    },
    "assist": {
      "enabled": false
    }
  }
}
